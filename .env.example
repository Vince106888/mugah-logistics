# Keep disabled on a public website. This exposes the in-memory CRM and simulated checkout demo.
VITE_ENABLE_DEMO_FEATURES=false

# Public routes on your own backend. Do not put API secrets in VITE_ variables.
VITE_MPESA_STK_ENDPOINT=
VITE_CARD_SESSION_ENDPOINT=

# Optional public bank-transfer details displayed on a signed payment link.
VITE_BANK_NAME=
VITE_BANK_ACCOUNT_NAME=
VITE_BANK_ACCOUNT_NUMBER=
VITE_BANK_BRANCH=

# Server-only placeholders for the future payment API. Configure these in your host,
# never in a VITE_ variable or committed file.
PAYMENT_LINK_SECRET=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
CARD_MERCHANT_ID=
CARD_API_KEY=
